# The app works in guest and account mode without this file.
# Copy to .env; keep it OUTSIDE public/. Never commit real keys.
APP_ENV=local
# Exact origin only when a reverse proxy changes Host. No trailing slash.
APP_ORIGIN=
APP_HTTPS=false
# Enable only behind your own trusted HTTPS reverse proxy:
TRUST_PROXY=false
SESSION_SAMESITE=Lax
# Optional HTTPS iframe deployment: SameSite=None + Secure + Partitioned (CHIPS).
SESSION_PARTITIONED=false
# Default database and sessions directory: project/storage
# STORAGE_PATH=/absolute/private/path/to/storage

# ---------------- Database ----------------
# sqlite (default): zero-config, storage/fitbot.sqlite, no import needed.
# mysql          : import database/fitbot_mysql.sql first, then fill these in.
#   XAMPP/Laragon defaults: host 127.0.0.1, user root, empty password.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fitbot
DB_USER=root
DB_PASS=
# Unix socket (optional; leave empty for TCP). XAMPP: /opt/lampp/var/mysql/mysql.sock
DB_SOCKET=


# Optional external LLM; model must support Chat Completions + tool calling.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_USER_DAILY_LIMIT=30
AI_GLOBAL_DAILY_LIMIT=100
# Keep false outside isolated local mock-provider tests.
ALLOW_INSECURE_AI=false
